# ==========================================================================
# RoboBulkChatBot — modelo de variaveis de ambiente
# Copie para .env e preencha com os valores reais. NAO versionar o .env.
# ==========================================================================

# --- voxi.example (site de origem) ---
VOXI_LOGIN_URL=https://voxi.example/login
VOXI_RELATORIOS_URL=https://voxi.example/relatorios
VOXI_USERNAME=            # e-mail ou nome.sobrenome do login
VOXI_PASSWORD=            # senha

# Tipo de relatorio a exportar (texto exato da opcao no combobox)
VOXI_TIPO_RELATORIO=Campanhas (Excel)

# Execucao do navegador
VOXI_HEADLESS=true        # true = sem janela (agendado); false = janela visivel (debug)
VOXI_SESSION_PATH=src/infrastructure/voxi/session/storage.json
VOXI_TIMEOUT_MS=60000     # timeout padrao das acoes do Playwright

# --- Destino SMB (\\10.0.0.72\Automacao\RELATORIOS_CAMPANHAS_CHATBOT) ---
# SMB_USER/SMB_PASSWORD sao OPCIONAIS: se ficarem vazios, o robo usa a conexao
# ja autenticada do Windows (sessao existente do PC), como os outros robos.
# Preencha apenas se precisar autenticar com um usuario/senha especifico.
SMB_SERVER=10.0.0.72
SMB_SHARE_PATH=\\10.0.0.72\Automacao\RELATORIOS_CAMPANHAS_CHATBOT
SMB_USER=                 # (opcional) usuario de rede com acesso ao compartilhamento
SMB_PASSWORD=             # (opcional) senha do usuario de rede

# --- Registro de execucao (banco LOGS_ROBOS.TB_LOG_EXECUCAO, servidor .66) ---
# Carimbo do "dia": marca que o relatorio de uma data ja foi transferido, para o
# robo poder rodar varias vezes sem reprocessar/reenviar. Se ja houver SUCESSO da
# data, a automacao encerra sem abrir o navegador.
DB_LOGS_SERVER=10.0.0.66    # servidor do banco LOGS_ROBOS
DB_LOGS_USER=                 # login SQL com acesso a TB_LOG_EXECUCAO
DB_LOGS_PASSWORD=             # senha do login SQL

# --- Log ---
ROBO_DEBUG=false          # true = log em nivel DEBUG


# --- demais variaveis lidas pelo codigo ---
DB_LOGS_DATABASE=LOGS_ROBOS
DB_LOGS_DRIVER=SQL SERVER
DB_LOGS_ENABLED=false
DB_LOGS_TABELA=TB_LOG_EXECUCAO
ROBO_ID_CEDENTE=
ROBO_ID_MAPA=
ROBO_NM_CEDENTE=RoboBulkChatBot
